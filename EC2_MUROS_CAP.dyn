        }
      ],
      "Outputs": [
        {
          "Id": "f27075e8d4ae484183fc1615410ff8c3",
          "Name": "Elements",
          "Description": "Una clase de elemento.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Obtiene todos los elementos de la categoría especificada en el modelo"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\r\nimport clr\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Documento activo de Revit\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Elementos recibidos desde Dynamo\r\nelementos = UnwrapElement(IN[0])\r\n\r\n# Asegurar que la entrada sea una lista\r\nif not isinstance(elementos, list):\r\n    elementos = [elementos]\r\n\r\n# Lista para almacenar los resultados\r\nregistros = []\r\n\r\nfor el in elementos:\r\n    if el is None:\r\n        continue\r\n\r\n    # Obtener el ID del muro\r\n    id_muro = el.Id.Value\r\n\r\n    # Obtener el nombre del tipo de muro\r\n    tipo = doc.GetElement(el.GetTypeId())\r\n    nombre = tipo.Name if tipo else \"Sin tipo\"\r\n\r\n    # Obtener el nivel base del muro\r\n    parametro = el.get_Parameter(\r\n        BuiltInParameter.WALL_BASE_CONSTRAINT\r\n    )\r\n\r\n    nivel = \"Sin nivel\"\r\n\r\n    if parametro:\r\n        nivel_id = parametro.AsElementId()\r\n        nivel_elemento = doc.GetElement(nivel_id)\r\n\r\n        if nivel_elemento:\r\n            nivel = nivel_elemento.Name\r\n\r\n    # Guardar la información\r\n    registros.append({\r\n        \"Id\": id_muro,\r\n        \"Nombre\": nombre,\r\n        \"Nivel\": nivel\r\n    })\r\n\r\n# Enviar resultados a Dynamo\r\n\r\nvalores_validos = [\"Concrete 12\", \"Concrete 18\", \"Concrete 24\"]\r\nfor r in registros:\r\n    if r[\"Nombre\"] is None or r[\"Nombre\"] == \"\":\r\n        r[\"Estado\"] = \"Falta parámetro\"\r\n    elif r[\"Nombre\"] not in valores_validos:\r\n        r[\"Estado\"] = \"Fuera de estándar\"\r\n    else:\r\n        r[\"Estado\"] = \"OK\"\r\n        \r\nencabezados = [\"Id\", \"Nombre\", \"Nivel\", \"Estado\"]\r\nfilas = [[r[\"Id\"], r[\"Nombre\"],\r\nr[\"Nivel\"], r[\"Estado\"]]\r\nfor r in registros]\r\nOUT = [encabezados] + filas\r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "e3a7f6819035405f99fb2eec52b893ac",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9c9e0d5fdfc14ad8bab6a86354e180e5",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
